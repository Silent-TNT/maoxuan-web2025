# DeepSeek 对话（Vercel / 本地咨询室必填）
DEEPSEEK_API_KEY=sk-xxx
# 可选：deepseek-chat / 若控制台提供 V4-Flash 的 model id 可在此覆盖
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# RAG 向量检索（构建索引 + 每次提问检索，硅基流动 OpenAI 兼容接口）
# 注册 https://cloud.siliconflow.cn 获取 API Key
EMBEDDING_API_KEY=sk-xxx
# 或使用别名：
# SILICONFLOW_API_KEY=sk-xxx
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# 注释语义定位（仅供本地批量生成脚本使用，不会进入浏览器）
# 若未设置，将复用 SILICONFLOW_API_KEY 或 EMBEDDING_API_KEY
# ANNOTATION_API_KEY=sk-xxx
ANNOTATION_BASE_URL=https://api.siliconflow.cn/v1
ANNOTATION_MODEL=deepseek-ai/DeepSeek-V3.2
# 低于该置信度的结果只进入复核清单，不会进入网页
ANNOTATION_MIN_CONFIDENCE=0.85
# 每次请求的角标数量与超时时间（毫秒）；分批可避免长文章阻塞
ANNOTATION_BATCH_SIZE=8
ANNOTATION_TIMEOUT_MS=60000
# 同时处理的文章数；过高可能触发账户限流
ANNOTATION_CONCURRENCY=2

# 设为 1 可关闭检索（仅用原有人设）
# RAG_DISABLED=1

# 百度统计（https://tongji.baidu.com → 管理 → 代码管理 → hm.js? 后面的 ID）
# 构建/部署时需设置；本地 docs:dev 可在 .env 中配置后重启
VITE_BAIDU_TONGJI_ID=
